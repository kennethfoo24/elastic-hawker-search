# Elastic Cloud Serverless project credentials — copy to .env.local (never committed)
# Find these in your serverless project: Cloud console → project → Endpoints / API keys
ELASTICSEARCH_URL=https://your-project.es.region.gcp.elastic.cloud:443
ELASTICSEARCH_API_KEY=your-base64-api-key
# Optional, defaults to hawker-dishes
# ES_INDEX=hawker-dishes
